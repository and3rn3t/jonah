{
    "name": "jonah",
    "engines": {
        "node": ">=24.22.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/and3rn3t/jonah.git"
    },
    "license": "MIT",
    "description": "Personal portfolio for Jonah (GitHub Spark template).",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "kill": "lsof -ti:5000 | xargs kill",
        "build": "tsc -b --noCheck && vite build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
        "typecheck": "tsc --noEmit && tsc -p functions --noEmit",
        "preview": "vite preview",
        "deploy": "npm run build && npx wrangler pages deploy dist",
        "pages:dev": "npx wrangler pages dev dist --kv SITE_KV --r2 PHOTOS"
    },
    "dependencies": {
        "@github/spark": ">=0.43.1 <1",
        "@phosphor-icons/react": "^2.1.10",
        "@radix-ui/colors": "^3.0.0",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-progress": "^1.1.2",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-tabs": "^1.1.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "lucide-react": "^0.577.0",
        "motion": "^12.6.2",
        "next-themes": "^0.4.6",
        "react": "^19.0.0",
        "react-dom": "^19.2.4",
        "react-error-boundary": "^6.0.0",
        "sonner": "^2.0.1",
        "tailwind-merge": "^3.0.2",
        "tw-animate-css": "^1.2.4"
    },
    "devDependencies": {
        "@and3rn3t/eslint-config": "^0.3.0",
        "@cloudflare/workers-types": "^4.20241127.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react-swc": "^4.2.2",
        "eslint": "^10.13.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^4.1.11",
        "typescript": "~6.0.3",
        "vite": "^7.3.6"
    }
}
